# PostgreSQL connection settings for the MCP server.
# Copy this file to .env and fill in your values. Never commit .env.

# Database server address (localhost for a database on this machine)
PGHOST=localhost
# Database server port (PostgreSQL's default is 5432)
PGPORT=5432
# Database user (a read-only user is recommended)
PGUSER=postgres
# Password for that user (special characters are fine; no quotes or encoding needed)
PGPASSWORD=change-me
# Name of the database to connect to
PGDATABASE=postgres
# SSL: leave empty for a local database; use "require" for most cloud databases
PGSSLMODE=

# --- LLM that turns your free text into SQL (OpenAI-compatible API) ---
# Base URL of the model API, usually ending in /v1
LLM_BASE_URL=https://your-model-host/v1
# Your API key
LLM_API_KEY=change-me
# Model name, exactly as the API lists it
LLM_MODEL=qwen3.8-27b-fp8

# --- Query limits ---
# Most rows one query may return
MAX_ROWS=500
# Longest a query may run, in milliseconds
QUERY_TIMEOUT_MS=15000
